{
  "manifest_version": 3,
  "name": "Color Switcher",
  "version": "0.3.0",
  "author": "Filip Majerík",
  "description": "Přepíná tmavý/světlý vzhled libovolného webu, invertuje barvy a vytváří vlastní barevná schémata z CSS stránky.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Color Switcher",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "preview/preview.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/color.js",
        "src/scheme.js",
        "src/settings.js",
        "src/transform.js",
        "src/content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "commands": {
    "toggle-site": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Zapnout/vypnout na aktuálním webu"
    }
  }
}
